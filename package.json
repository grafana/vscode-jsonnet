{
  "name": "vscode-jsonnet",
  "icon": "icon.png",
  "displayName": "Jsonnet Language Server",
  "description": "Full code support (formatting, highlighting, navigation, debugging etc) for Jsonnet",
  "license": "Apache License Version 2.0",
  "publisher": "Grafana",
  "version": "0.7.5-rtk5",
  "repository": {
    "type": "git",
    "url": "https://github.com/grafana/vscode-jsonnet"
  },
  "engines": {
    "vscode": "^1.61.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Debuggers"
  ],
  "keywords": [
    "jsonnet",
    "grafana",
    "lsp",
    "language",
    "debugger"
  ],
  "activationEvents": [
    "onLanguage:jsonnet"
  ],
  "main": "./out/extension",
  "contributes": {
    "menus": {
      "editor/title": [
        {
          "command": "jsonnet.evalFile",
          "alt": "jsonnet.evalFileYaml",
          "group": "navigation",
          "when": "resourceLangId == jsonnet"
        }
      ],
      "editor/title/run": [
        {
          "command": "jsonnet.debugEditorContents",
          "when": "resourceLangId == jsonnet",
          "group": "navigation@1"
        }
      ]
    },
    "commands": [
      {
        "command": "jsonnet.evalFile",
        "title": "Jsonnet: Evaluate File",
        "enablement": "resourceLangId == jsonnet",
        "icon": "$(open-preview)"
      },
      {
        "command": "jsonnet.evalFileYaml",
        "title": "Jsonnet: Evaluate File (YAML)",
        "enablement": "resourceLangId == jsonnet",
        "icon": "$(open-preview)"
      },
      {
        "command": "jsonnet.evalExpression",
        "title": "Jsonnet: Evaluate Expression",
        "enablement": "resourceLangId == jsonnet"
      },
      {
        "command": "jsonnet.evalExpressionYaml",
        "title": "Jsonnet: Evaluate Expression (YAML)",
        "enablement": "resourceLangId == jsonnet"
      },
      {
        "command": "jsonnet.findTransitiveImporters",
        "title": "Jsonnet: Find Transitive Importers",
        "enablement": "resourceLangId == jsonnet"
      },
      {
        "command": "jsonnet.restartLanguageServer",
        "title": "Jsonnet: Restart Language Server"
      },
      {
        "command": "jsonnet.debugEditorContents",
        "title": "Jsonnet: Debug File",
        "category": "Jsonnet",
        "enablement": "!inDebugMode",
        "icon": "$(debug-alt)"
      }
    ],
    "languages": [
      {
        "id": "jsonnet",
        "aliases": [
          "Jsonnet",
          "jsonnet"
        ],
        "extensions": [
          ".jsonnet",
          ".libsonnet"
        ],
        "configuration": "./language/configuration.jsonc"
      }
    ],
    "grammars": [
      {
        "language": "jsonnet",
        "scopeName": "source.jsonnet",
        "path": "./language/jsonnet.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "jsonnet"
      }
    ],
    "debuggers": [
      {
        "type": "jsonnet",
        "languages": [
          "jsonnet"
        ],
        "label": "Jsonnet Debugger",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "jpaths"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "jsonnet script to run"
              },
              "jpaths": {
                "type": "array",
                "description": "jsonnet search paths",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "initialConfigurations": [],
        "configurationSnippets": [
          {
            "label": "Jsonnet: Debug current file",
            "description": "A new configuration for debugging a Jsonnet file.",
            "body": {
              "type": "jsonnet",
              "request": "launch",
              "name": "Debug current JSONNET file",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Jsonnet Language Server",
      "properties": {
        "jsonnet.languageServer.releaseRepository": {
          "type": "string",
          "default": "grafana/rustanka",
          "description": "Github repository to download the language server from"
        },
        "jsonnet.languageServer.enableAutoUpdate": {
          "scope": "resource",
          "type": "boolean",
          "default": true
        },
        "jsonnet.languageServer.pathToBinary": {
          "scope": "resource",
          "type": "string",
          "description": "Path to language server binary"
        },
        "jsonnet.languageServer.extVars": {
          "scope": "resource",
          "type": "object",
          "default": {},
          "description": "External variables to pass to the language server"
        },
        "jsonnet.languageServer.extCode": {
          "scope": "resource",
          "type": "object",
          "default": {},
          "description": "External Jsonnet Code to pass to the language server"
        },
        "jsonnet.languageServer.jpath": {
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Import search paths (-J). Relative paths are resolved from the workspace root."
        },
        "jsonnet.languageServer.enableEvalDiagnostics": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Enable evaluation diagnostics"
        },
        "jsonnet.languageServer.enableLintDiagnostics": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Enable lint diagnostics"
        },
        "jsonnet.languageServer.resolvePathsWithTanka": {
          "scope": "resource",
          "type": [
            "string",
            "boolean"
          ],
          "enum": [
            "false",
            "auto",
            "true"
          ],
          "default": "auto",
          "description": "Resolve import paths with Tanka conventions"
        },
        "jsonnet.languageServer.continuousEval": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Whether to continuously evaluate the selected file"
        },
        "jsonnet.languageServer.codeActions.removeUnused": {
          "scope": "resource",
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "importBindings",
            "nonImportBindings"
          ],
          "markdownDescription": "Controls how `source.fixAll`/quick fixes remove unused bindings.",
          "markdownEnumDescriptions": [
            "Remove both unused import and non-import bindings.\n\nExample:\n```jsonnet\nlocal keep = 1;\nlocal drop = 2;\nkeep\n```\nbecomes:\n```jsonnet\nlocal keep = 1;\nkeep\n```",
            "Remove only unused import bindings.",
            "Remove only unused non-import bindings."
          ]
        },
        "jsonnet.languageServer.codeActions.removeUnusedComments": {
          "scope": "resource",
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "above",
            "below",
            "all"
          ],
          "markdownDescription": "Controls comment handling when remove-unused code actions edit declarations.",
          "markdownEnumDescriptions": [
            "Do not remove comments near removed declarations.",
            "Remove comments immediately above removed declarations.\n\nGiven:\n```jsonnet\n// keep?\nlocal drop = 1;\n```\nwhen `drop` is removed, `// keep?` is also removed.",
            "Remove comments immediately below removed declarations.",
            "Remove both above and below comments near removed declarations."
          ]
        },
        "jsonnet.languageServer.inlayHints.local": {
          "scope": "resource",
          "type": "string",
          "default": "all",
          "enum": [
            "off",
            "variables",
            "functions",
            "all"
          ],
          "markdownDescription": "Controls inlay hints for `local` bindings.",
          "markdownEnumDescriptions": [
            "Disable local-binding inlay hints.",
            "Show hints for local variables only (for example `local value = ...`).",
            "Show hints for local functions only (for example `local build(x) = ...`).",
            "Show hints for both variables and functions."
          ]
        },
        "jsonnet.languageServer.inlayHints.objectLocal": {
          "scope": "resource",
          "type": "string",
          "default": "all",
          "enum": [
            "off",
            "variables",
            "functions",
            "all"
          ],
          "description": "Controls inlay hints for object-local bindings.",
          "markdownEnumDescriptions": [
            "Disable object-local inlay hints.",
            "Show hints for object-local variables only.",
            "Show hints for object-local functions only.",
            "Show hints for both variables and functions."
          ]
        },
        "jsonnet.languageServer.inlayHints.objectMembers": {
          "scope": "resource",
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "fields",
            "methods",
            "all"
          ],
          "description": "Controls inlay hints for object members.",
          "markdownEnumDescriptions": [
            "Disable object-member inlay hints.",
            "Show hints for object fields only.",
            "Show hints for object methods only.",
            "Show hints for both fields and methods."
          ]
        },
        "jsonnet.languageServer.inlayHints.functionParameters": {
          "scope": "resource",
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "all"
          ],
          "description": "Controls inlay hints for function parameters.",
          "markdownEnumDescriptions": [
            "Disable function-parameter inlay hints.",
            "Show function-parameter inlay hints."
          ]
        },
        "jsonnet.languageServer.inlayHints.anonymousFunctionReturns": {
          "scope": "resource",
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "all"
          ],
          "description": "Controls inlay hints for anonymous function returns.",
          "markdownEnumDescriptions": [
            "Disable anonymous-function return inlay hints.",
            "Show anonymous-function return inlay hints."
          ]
        },
        "jsonnet.languageServer.inlayHints.callArguments": {
          "scope": "resource",
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "all"
          ],
          "description": "Controls inlay hints for call arguments.",
          "markdownEnumDescriptions": [
            "Disable call-argument inlay hints.",
            "Show call-argument inlay hints."
          ]
        },
        "jsonnet.languageServer.inlayHints.comprehensions": {
          "scope": "resource",
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "all"
          ],
          "description": "Controls inlay hints for comprehension bindings.",
          "markdownEnumDescriptions": [
            "Disable comprehension-binding inlay hints.",
            "Show comprehension-binding inlay hints."
          ]
        },
        "jsonnet.languageServer.inlayHints.destructuring": {
          "scope": "resource",
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "all"
          ],
          "markdownDescription": "Controls inlay hints for destructured comprehension bindings.",
          "markdownEnumDescriptions": [
            "Disable destructured-comprehension inlay hints.",
            "Show destructured-comprehension inlay hints.\n\nExample:\n```jsonnet\n[for [name, age] in people: name]\n```\nWhen both `comprehensions = all` and `destructuring = all`, hints are shown for both `name` and `age`."
          ]
        },
        "jsonnet.languageServer.formatting.maxBlankLines": {
          "scope": "resource",
          "type": "number",
          "default": 2,
          "description": "Maximum consecutive blank lines."
        },
        "jsonnet.languageServer.formatting.stringStyle": {
          "scope": "resource",
          "type": "string",
          "default": "leave",
          "enum": [
            "double",
            "single",
            "leave",
            "d",
            "s"
          ],
          "markdownDescription": "Preferred string quote style.",
          "markdownEnumDescriptions": [
            "Prefer double quotes.\n\nExample:\n```jsonnet\n{\n  msg: \"hello\",\n}\n```",
            "Prefer single quotes.\n\nExample:\n```jsonnet\n{\n  msg: 'hello',\n}\n```",
            "Preserve existing quote style when possible.",
            "Alias for `double`.",
            "Alias for `single`."
          ]
        },
        "jsonnet.languageServer.formatting.commentStyle": {
          "scope": "resource",
          "type": "string",
          "default": "leave",
          "enum": [
            "hash",
            "slash",
            "leave",
            "h",
            "s"
          ],
          "markdownDescription": "Preferred comment style.",
          "markdownEnumDescriptions": [
            "Prefer `#` comments.\n\nExample:\n```jsonnet\n# explanation\nlocal x = 1;\n```",
            "Prefer `//` comments.\n\nExample:\n```jsonnet\n// explanation\nlocal x = 1;\n```",
            "Preserve existing comment style when possible.",
            "Alias for `hash`.",
            "Alias for `slash`."
          ]
        },
        "jsonnet.languageServer.formatting.padArrays": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Whether to pad arrays with spaces where supported by the formatter."
        },
        "jsonnet.languageServer.formatting.padObjects": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Whether to pad objects with spaces where supported by the formatter."
        },
        "jsonnet.languageServer.formatting.prettyFieldNames": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable formatter field-name prettification where applicable."
        },
        "jsonnet.languageServer.logLevel": {
          "scope": "resource",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            null
          ],
          "default": null,
          "description": "Optional runtime log level for the jrsonnet-lsp process"
        },
        "jsonnet.debugger.releaseRepository": {
          "type": "string",
          "default": "grafana/jsonnet-debugger",
          "description": "Github repository to download the debugger server from"
        },
        "jsonnet.debugger.enableAutoUpdate": {
          "scope": "resource",
          "type": "boolean",
          "default": true
        },
        "jsonnet.debugger.pathToBinary": {
          "scope": "resource",
          "type": "string",
          "description": "Path to debugger"
        }
      }
    }
  },
  "dependencies": {
    "@types/vscode": "^1.69.0",
    "vscode-languageclient": "^8.0.0",
    "yaml": "^1.10.2"
  },
  "devDependencies": {
    "@types/node": "^12.12.0",
    "@typescript-eslint/eslint-plugin": "^4.23.0",
    "@typescript-eslint/parser": "^4.23.0",
    "eslint": "^7.26.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "lint": "eslint ./src --ext .ts,.tsx"
  }
}
